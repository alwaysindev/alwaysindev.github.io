---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-youtube.jpg';
import { BRAND, PERSON, PROFILES } from '../config/site';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const year = new Date().getFullYear();
const en = lang === 'en';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-about">
      <a href="/" class="brand">
        <Image src={logo} alt="" width={72} height={72} />
        alwaysInDEV
      </a>
      <p>
        {
          en
            ? 'Hands-on technical content in Spanish about AI, Data Science and programming. Created by '
            : 'Divulgación técnica en español sobre IA, Data Science y programación. Un proyecto de '
        }
        <a href="/sobre-mi/">{PERSON.shortName}</a>.
      </p>
    </div>
    <div>
      <h2>{en ? 'Site' : 'Sitio'}</h2>
      <ul>
        <li><a href="/contenido/">Contenido</a></li>
        <li><a href="/formacion/">Formación</a></li>
        <li><a href="/charlas/">Charlas</a></li>
        <li><a href="/sobre-mi/">Sobre mí</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href="/prensa/">Prensa</a></li>
        <li><a href="/sobre-este-sitio/">Sobre este sitio</a></li>
      </ul>
    </div>
    <div>
      <h2>{en ? 'Follow' : 'Redes'}</h2>
      <ul>
        <li><a href={BRAND.socials.youtube} rel="me noopener" target="_blank">YouTube</a></li>
        <li><a href={BRAND.socials.github} rel="me noopener" target="_blank">GitHub</a></li>
        <li><a href={BRAND.socials.instagram} rel="me noopener" target="_blank">Instagram</a></li>
        <li><a href={BRAND.socials.tiktok} rel="me noopener" target="_blank">TikTok</a></li>
        <li><a href={PROFILES.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>
  <p class="footer-copy">© {year} {BRAND.name} · {en ? 'Data Science, AI and knowledge in evolution.' : 'Ciencia de Datos, IA y conocimiento en evolución.'}</p>
</footer>
