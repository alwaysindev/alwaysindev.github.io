---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-youtube.jpg';
import { NAV } from '../config/site';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const path = Astro.url.pathname;
const LABELS: Record<string, string> = {
  contenido: 'Contenido',
  formacion: 'Formación',
  charlas: 'Charlas',
  'sobre-mi': 'Sobre mí',
  blog: 'Blog',
  contacto: 'Contacto',
};
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand">
      <Image src={logo} alt="" width={72} height={72} loading="eager" />
      alwaysInDEV
    </a>
    <nav aria-label={lang === 'en' ? 'Main' : 'Principal'}>
      <ul class="nav-links">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {LABELS[item.label] ?? item.label}
              </a>
            </li>
          ))
        }
        {
          lang === 'es' ? (
            <li>
              <a href="/en/" hreflang="en" lang="en">EN</a>
            </li>
          ) : (
            <li>
              <a href="/" hreflang="es" lang="es">ES</a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
