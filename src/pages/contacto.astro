---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { PERSON, PROFILES, BRAND } from '../config/site';

const crumbs = [{ name: 'Contacto', path: '/contacto/' }];

const reasons = [
  { title: 'Formación', subject: 'Formación', text: 'Tema, número de personas, nivel, formato (remoto o presencial) y fechas aproximadas.' },
  { title: 'Charla o taller', subject: 'Charla', text: 'Evento, fecha, duración del hueco, público esperado y si se graba.' },
  { title: 'Colaboración', subject: 'Colaboración', text: 'Qué propones (vídeo, proyecto, IA o GEO) y en qué plazo.' },
];
const mailto = (s: string) =>
  PERSON.email ? `mailto:${PERSON.email}?subject=${encodeURIComponent(`[alwaysInDEV] ${s}`)}` : PROFILES.linkedin;
---

<Base
  title="Contacto: formación, charlas y colaboraciones"
  description="Contacta con alwaysInDEV y Alejandro Cárabe para formación en Data Science y Claude, charlas técnicas o colaboraciones sobre IA generativa y GEO."
  pageType="ContactPage"
  crumbs={crumbs}
>
  <PageHeader crumbs={crumbs} label="contacto" title="Hablemos">
    <p>
      {
        PERSON.email
          ? 'Escríbeme por email indicando el motivo. Respondo en pocos días laborables.'
          : 'La forma más rápida de contactar es un mensaje por LinkedIn indicando el motivo.'
      }
    </p>
  </PageHeader>

  <section style="padding-top:2rem">
    <div class="section-inner">
      <div class="grid">
        {
          reasons.map((r) => (
            <a class="card hoverable card-accent" href={mailto(r.subject)} rel="noopener" target={PERSON.email ? undefined : '_blank'}>
              <h2 style="font-size:1.25rem;margin-bottom:.6rem">{r.title}</h2>
              <p>
                <strong style="color:var(--text-primary)">Incluye:</strong> {r.text}
              </p>
              <span class="more">{PERSON.email ? 'Escribir email →' : 'Escribir por LinkedIn →'}</span>
            </a>
          ))
        }
      </div>
      <div class="btn-row" style="margin-top:2.5rem">
        <a class="btn btn-outline" href={PROFILES.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        <a class="btn btn-outline" href={PROFILES.sessionize} rel="me noopener" target="_blank">Sessionize</a>
        <a class="btn btn-outline" href={BRAND.socials.youtube} rel="noopener" target="_blank">YouTube</a>
      </div>
    </div>
  </section>
</Base>
