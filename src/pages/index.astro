---
import { getPosts } from '../lib/posts';
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { BRAND, PERSON, employerLine } from '../config/site';
import { TALKS, TEACHING, PROJECTS } from '../data/profile';

const posts = (await getPosts()).slice(0, 3);

const scenarios = TALKS.map((t) => t.event.split(' — ')[0]);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  isHome
  title="alwaysInDEV — IA, Data Science y programación en español"
  description="alwaysInDEV es un proyecto de divulgación técnica en español sobre IA, Data Science y programación: vídeos, formación, charlas y código abierto."
  alternates={{ es: '/', en: '/en/' }}
>
  <section class="hero">
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="hero-badge"><span class="pulse" aria-hidden="true"></span>Contenido técnico en español</p>
      <h1 class="hero-title">
        <span class="line1">Data Science,</span><br />
        <span class="line2">sin filtros.</span>
      </h1>
      <p class="hero-sub">
        <strong>alwaysInDEV</strong> es un proyecto de divulgación sobre
        <span class="highlight">IA, Data Science y programación</span> en español: vídeos, formación, charlas y
        código abierto, creado por <a href="/sobre-mi/">{PERSON.shortName}</a>.
      </p>
      <div class="btn-row hero-cta">
        <a href={BRAND.socials.youtube} class="btn btn-primary" rel="noopener" target="_blank">&#9654; Ver el canal</a>
        <a href="/formacion/" class="btn btn-outline">Formación para equipos</a>
        <a href="/charlas/" class="btn btn-outline">Charlas</a>
      </div>
    </div>
  </section>

  <div class="terminal-section">
    <Terminal
      lines={[
        { cmd: 'cat about.yaml' },
        { out: 'proyecto: alwaysInDEV  # IA · Data Science · programación' },
        { out: `creador: ${PERSON.shortName.toLowerCase().replace(' ', '_')}` },
        { cmd: 'cat --stack temas.yaml' },
        { out: 'python · sql · llms · claude · geo · web_scraping · ml' },
        { cmd: 'echo "¿Nos vemos en el próximo vídeo?"' },
        { out: '¿Nos vemos en el próximo vídeo?' },
      ]}
    />
  </div>

  <div class="separator"></div>

  <section id="que-es">
    <div class="section-inner">
      <p class="section-label">qué es</p>
      <h2 class="section-title">¿Qué es alwaysInDEV?</h2>
      <p class="section-desc">
        Es el contenido técnico que nos habría gustado encontrar cuando empezamos: práctico, en español y sin relleno.
        Nace en YouTube y hoy incluye formación para equipos, charlas en eventos y repositorios abiertos.
      </p>
      <div class="grid">
        <a class="card hoverable reveal" href="/contenido/">
          <span class="card-icon" aria-hidden="true">&#127909;</span>
          <h3>Vídeos y píldoras</h3>
          <p>Tutoriales largos en YouTube y píldoras de 60 segundos sobre Python, Data Science, LLMs y herramientas.</p>
          <span class="more">~/contenido →</span>
        </a>
        <a class="card hoverable reveal" href="/formacion/">
          <span class="card-icon" aria-hidden="true">&#127891;</span>
          <h3>Formación</h3>
          <p>Bootcamps, másteres y formación a medida en Data Science, web scraping, IA generativa y Claude.</p>
          <span class="more">~/formacion →</span>
        </a>
        <a class="card hoverable reveal" href="/charlas/">
          <span class="card-icon" aria-hidden="true">&#127908;</span>
          <h3>Charlas</h3>
          <p>Charlas técnicas y talleres sobre scraping, GEO y Claude Code para eventos y comunidades.</p>
          <span class="more">~/charlas →</span>
        </a>
        <a class="card hoverable reveal" href="/contenido/#codigo">
          <span class="card-icon" aria-hidden="true">&#128187;</span>
          <h3>Código abierto</h3>
          <p>{PROJECTS.length} repositorios públicos con el material de los cursos y vídeos, listos para practicar.</p>
          <span class="more">~/contenido#codigo →</span>
        </a>
      </div>
    </div>
  </section>

  <div class="separator"></div>

  <section id="quien">
    <div class="section-inner">
      <p class="section-label">quién está detrás</p>
      <div class="profile">
        <div class="avatar" aria-hidden="true">
          {PERSON.headshot ? <img src={PERSON.headshot} alt="" width="96" height="96" /> : PERSON.initials}
        </div>
        <div>
          <h2 class="section-title">{PERSON.shortName}</h2>
          <p class="lead" style="margin-bottom:1rem">
            AI Engineer y Data Scientist en {PERSON.city}. {employerLine()} Forma en Data Science, web scraping y Claude
            en The Bridge y MBIT School, y está certificado como <strong>Claude Certified Architect – Foundations</strong>.
            Cofundó alwaysInDEV con {BRAND.cofounder.name}.
          </p>
          <a class="btn btn-outline" href="/sobre-mi/">Sobre mí →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="separator"></div>

  <section id="donde">
    <div class="section-inner">
      <p class="section-label">dónde</p>
      <h2 class="section-title">Aulas y escenarios</h2>
      <p class="section-desc">Formación y charlas en escuelas, empresas y eventos técnicos.</p>
      <ul class="tags" aria-label="Centros de formación">
        {TEACHING.map((t) => <li class="tag">{t.org}</li>)}
      </ul>
      <ul class="tags" aria-label="Eventos" style="margin-top:0.8rem">
        {scenarios.map((s) => <li class="tag">{s}</li>)}
      </ul>
    </div>
  </section>

  {
    posts.length > 0 && (
      <>
        <div class="separator" />
        <section id="blog">
          <div class="section-inner">
            <p class="section-label">blog</p>
            <h2 class="section-title">Últimos artículos</h2>
            <div class="grid">
              {posts.map((p) => (
                <a class="card hoverable reveal" href={`/blog/${p.id}/`}>
                  <time class="meta" datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                  <span class="more">Leer →</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      </>
    )
  }

  <div class="separator"></div>

  <section class="cta-section">
    <div class="section-inner" style="text-align:center">
      <p class="section-label">conecta</p>
      <h2 class="section-title">¿Hablamos?</h2>
      <p class="section-desc" style="margin:0 auto 2rem">
        Para formación, charlas o colaboraciones, escríbeme. Para aprender, el canal es el mejor sitio para empezar.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a href="/contacto/" class="btn btn-primary">Contacto</a>
        <a href={BRAND.socials.youtube} class="btn btn-outline" rel="noopener" target="_blank">YouTube</a>
        <a href={BRAND.socials.github} class="btn btn-outline" rel="noopener" target="_blank">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9rem 2rem 4rem;
  }
  .hero-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    max-width: 100vw;
    border-radius: 50%;
    filter: blur(150px);
    opacity: 0.4;
    pointer-events: none;
  }
  .hero-glow-1 {
    top: 10%;
    left: 15%;
    background: radial-gradient(circle, rgba(74, 222, 128, 0.15), transparent);
  }
  .hero-glow-2 {
    bottom: 10%;
    right: 10%;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent);
  }
  .hero-content {
    max-width: 900px;
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    background: var(--bg-secondary);
    animation: fadeInDown 0.8s ease-out;
  }
  .pulse {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.4); }
    50% { opacity: 0.8; box-shadow: 0 0 0 8px rgba(74, 222, 128, 0); }
  }
  /* Sin animación de opacidad en el h1: es el elemento LCP y debe pintarse ya. */
  .hero-title {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -3px;
    margin-bottom: 1.5rem;
  }
  .line2 {
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto 3rem;
    line-height: 1.8;
  }
  .hero-sub strong {
    color: var(--text-primary);
  }
  .hero-sub .highlight {
    color: var(--accent-green);
  }
  .hero-sub a {
    color: var(--accent-cyan);
  }
  .hero-cta {
    justify-content: center;
    animation: fadeInUp 0.8s ease-out 0.3s both;
  }
  .terminal-section {
    position: relative;
    z-index: 1;
    padding: 0 2rem 6rem;
  }
  @media (max-width: 860px) {
    .hero {
      padding: 9rem 1rem 3rem;
      min-height: auto;
    }
    .hero-title {
      letter-spacing: -1.5px;
    }
    .terminal-section {
      padding: 0 1rem 4rem;
    }
  }
</style>
