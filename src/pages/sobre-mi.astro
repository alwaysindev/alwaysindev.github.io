---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, PERSON, BRAND, PROFILES, employerLine, employerStatus, EMPLOYER } from '../config/site';
import { EXPERIENCE, CERTIFICATIONS, isActive, ABOUT_FAQ } from '../data/profile';
import { IDS, faqNode, abs } from '../lib/schema';

const crumbs = [{ name: 'Sobre mí', path: '/sobre-mi/' }];
const status = employerStatus();

const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function ym(s: string) {
  const [y, m] = s.split('-');
  return m ? `${MONTHS[Number(m) - 1]} ${y}` : y;
}
const sorted = [...EXPERIENCE].sort((a, b) => b.start.localeCompare(a.start));
---

<Base
  title="Sobre mí: Alejandro Cárabe"
  description="Alejandro Cárabe Arranz, AI Engineer y Data Scientist en Madrid. Formador en Data Science, web scraping y Claude, ponente y creador de alwaysInDEV."
  pageType="ProfilePage"
  mainEntity={IDS.person}
  ogType="profile"
  crumbs={crumbs}
  dateModified={SITE.lastReviewed}
  schema={[faqNode(abs('/sobre-mi/'), ABOUT_FAQ)]}
>
  <PageHeader crumbs={crumbs} label="sobre mí" title="Alejandro Cárabe" updated={SITE.lastReviewed}>
    <p>
      <strong>Alejandro Cárabe Arranz</strong> es AI Engineer y Data Scientist en {PERSON.city}. {employerLine()}
      Forma en Data Science, web scraping y Claude en The Bridge y MBIT School, coordina un programa de Data Analytics
      aplicada al deporte para ASE Athletics y creó <a href="/">alwaysInDEV</a>, un proyecto de divulgación técnica en
      español.
    </p>
  </PageHeader>

  <section style="padding-top:2rem">
    <div class="section-inner">
      <div class="grid grid-2">
        <div class="card card-accent">
          <span class="meta">// ahora</span>
          <h2 style="font-size:1.3rem;margin-bottom:.6rem">En qué trabajo</h2>
          <p>
            {
              status === 'hidden'
                ? `${EMPLOYER.previous.title} en ${EMPLOYER.previous.company}.`
                : status === 'current'
                  ? `Soy ${EMPLOYER.title} en ${EMPLOYER.company}, donde trabajo en ${EMPLOYER.project} para ${EMPLOYER.client}: que la marca aparezca de forma correcta en las respuestas de los buscadores con IA.`
                  : `Me incorporo a ${EMPLOYER.company} como ${EMPLOYER.title} en ${EMPLOYER.project} para ${EMPLOYER.client}: que la marca aparezca de forma correcta en las respuestas de los buscadores con IA.`
            }
          </p>
          <p style="margin-top:.8rem">
            En paralelo, doy clase en el bootcamp de Data Science e IA de The Bridge, formo en Claude y enseño web
            scraping en dos másteres de MBIT School.
          </p>
        </div>
        <div class="card card-accent">
          <span class="meta">// especialidad</span>
          <h2 style="font-size:1.3rem;margin-bottom:.6rem">De qué sé</h2>
          <ul class="tags" style="margin-top:0">
            {PERSON.knowsAbout.map((k) => <li class="tag">{k}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="trayectoria" style="padding-top:2rem">
    <div class="section-inner">
      <p class="section-label">trayectoria</p>
      <h2 class="section-title">Experiencia</h2>
      <ol class="timeline">
        {
          sorted.map((e) => (
            <li>
              <span class="when">
                {ym(e.start)} – {e.end ? ym(e.end) : 'actualidad'}
              </span>
              <h3>
                {e.role} · <span class="org">{e.orgUrl ? <a href={e.orgUrl} rel="noopener" target="_blank">{e.org}</a> : e.org}</span>
              </h3>
              {e.summary && <p>{e.summary}</p>}
            </li>
          ))
        }
      </ol>
      <p class="updated" style="margin-top:1rem">
        Formación: {PERSON.education.join(' · ')}.
      </p>
    </div>
  </section>

  <section id="certificaciones" style="padding-top:2rem">
    <div class="section-inner">
      <p class="section-label">certificaciones</p>
      <h2 class="section-title">Certificaciones</h2>
      <div class="grid">
        {
          CERTIFICATIONS.map((c) => (
            <div class="card">
              <span class="meta">
                {c.issuer} · {ym(c.issued.slice(0, 7))}
              </span>
              <h3>{c.name}</h3>
              <ul class="tags">
                {isActive(c) ? <li class="tag">vigente</li> : <li class="tag warn">caducada ({ym(c.expires!)})</li>}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="alwaysindev" style="padding-top:2rem">
    <div class="section-inner">
      <p class="section-label">alwaysInDEV</p>
      <h2 class="section-title">El proyecto</h2>
      <p class="section-desc">
        alwaysInDEV nació como canal de YouTube que cofundé con {BRAND.cofounder.name}. Hoy es el paraguas de todo lo
        que hago para enseñar: vídeos, formación, charlas y código abierto.
      </p>
      <div class="btn-row">
        <a class="btn btn-outline" href="/contenido/">Ver el contenido</a>
        <a class="btn btn-outline" href={PROFILES.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        <a class="btn btn-outline" href={PROFILES.sessionize} rel="me noopener" target="_blank">Sessionize</a>
      </div>
    </div>
  </section>

  <section id="faq" style="padding-top:2rem">
    <div class="section-inner">
      <p class="section-label">faq</p>
      <h2 class="section-title">Preguntas frecuentes</h2>
      <div class="faq">
        {
          ABOUT_FAQ.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
